{
  "name": "softscope",
  "version": "0.2.0",
  "description": "Lightweight Node.js CLI profiler for benchmarks and performance suites: function execution frequency, self/total duration, call graphs, and runtime reach",
  "type": "module",
  "bin": {
    "softscope": "bin/softscope.js"
  },
  "main": "./src/cli.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/cli.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./src/vite/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./src/vite/client.js"
    },
    "./loader": "./src/loader/register.js",
    "./hooks": "./src/loader/hooks.mjs"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "bench": "node bench/run.js"
  },
  "keywords": [
    "profiler",
    "observability",
    "instrumentation",
    "oxc",
    "metrics",
    "runtime",
    "reach",
    "benchmark",
    "autobench",
    "fuzzing",
    "regression"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "author": "cond",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litepacks/softscope.git"
  },
  "homepage": "https://github.com/litepacks/softscope#readme",
  "bugs": {
    "url": "https://github.com/litepacks/softscope/issues"
  },
  "dependencies": {
    "magic-string": "^1.4.1",
    "oxc-parser": "^0.150.0",
    "picomatch": "^4.0.2"
  }
}
